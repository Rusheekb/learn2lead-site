# Test-only credentials for local Playwright click-throughs. Copy this file
# to .env.test (already gitignored) and fill in real values there — never
# put real values in this .example file, and never use real family/admin
# accounts here. Use dedicated throwaway test accounts with no real payment
# history attached.

TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=

TEST_TUTOR_EMAIL=
TEST_TUTOR_PASSWORD=

TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
