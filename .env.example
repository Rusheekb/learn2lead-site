# Copy to .env.local for local development. Never commit real values.
# Production values are set in Vercel (Project → Settings → Environment Variables).

# Supabase. In development, set both to use a different backend (e.g. a local
# `supabase start` stack); production always uses the live project.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe price IDs: "live" or "test" (src/config/stripe.ts).
# VITE_STRIPE_MODE=test

# Feature flags (off unless "true").
# VITE_ENABLE_FAMILY_SIGNUP=true   # parent sign-up choice and "Invite a parent"
# VITE_ENABLE_SMS=true             # text-message settings (needs Twilio set up)

# Google's own sign-in button (docs/google-sign-in.md). Unset = redirect flow.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Error monitoring (optional). https://sentry.io → Project → Client Keys (DSN)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
